# atlas.shacl AdaptedFromReferenceAgreementShape (Warning): the target attackId
# differs from the cited attack-reference.id, as after a revoked-by remap.
fx:aml-neg a atlas:AtlasTechnique ;
    atlas:atlasId "AML.T0050" ;
    atlas:name "Negative case technique" ;
    atlas:description "Mutation individual for a negative case." ;
    atlas:createdDate "2023-02-28"^^xsd:date ;
    atlas:modifiedDate "2026-05-27"^^xsd:date ;
    atlas:maturity "Realized" ;
    atlas:platforms "Enterprise" ;
    atlas:part_of fx:aml-ta0015 ;
    atlas:adapted_from fx:t1059 .

fx:af-neg a atlas:AdaptedFromStatement ;
    rdf:subject fx:aml-neg ;
    rdf:predicate atlas:adapted_from ;
    rdf:object fx:t1059 ;
    atlas:sourceField "attack-reference" ;
    atlas:attackReferenceId "T1086" ;
    atlas:attackReferenceUrl "https://attack.mitre.org/techniques/T1086/" .
