# decision.shacl KevEntryShape is closed: a KevEntry may not point at a Weakness
# (KEV cwes stay strings on the entry; no CAUSED_BY from a KEV entry, ADR-0003).
fx:kev-1 kgcs:caused_by fx:cwe-79 .
