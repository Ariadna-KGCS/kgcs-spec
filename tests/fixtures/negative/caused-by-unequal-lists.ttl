@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix kgcs:   <http://www.motherhacker.me/kgcs/ontology/core#> .
@prefix cve:    <http://www.motherhacker.me/kgcs/ontology/cve#> .
@prefix fx:     <urn:kgcs:fixture:> .

# cve.shacl v1.2 CausedByStatementShape: two assigning sources but only one
# type - the aligned CAUSED_BY lists have unequal length (ADR-0002).
fx:cve-2 a kgcs:Vulnerability ;
    cve:cveId "CVE-2024-0002" ;
    cve:published "2024-03-01T08:00:00Z"^^xsd:dateTime ;
    cve:source "secalert@redhat.com" ;
    kgcs:caused_by fx:cwe-79 .

fx:cb-cve-2-cwe-79 a cve:CausedByStatement ;
    rdf:subject fx:cve-2 ;
    rdf:predicate kgcs:caused_by ;
    rdf:object fx:cwe-79 ;
    cve:weaknessSources ( "nvd@nist.gov" "secalert@redhat.com" ) ;
    cve:weaknessSourceRoles ( "nvd" "cna" ) ;
    cve:weaknessTypes ( "Primary" ) .
