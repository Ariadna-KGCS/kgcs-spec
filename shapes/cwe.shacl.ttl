# KGCS CWE SHACL Shapes v1.1
#
# Validates Weakness nodes against the CWE ontology
# (ontology/standards/cwe-ontology-v1.0.owl) and the CWE
# enrichment module (ontology/standards/cwe-enrichment-v1.0.owl).
#
# Source standard: MITRE CWE XML catalog (Core Definition XSD v7.3)
# Enforcement level: STRICT (reject at ingest)
#
# v1.1: adds enrichment property shapes (description, mapping
# guidance, structure/status, enum facets). Properties that are
# required in the CWE XSD (Description, Mapping_Notes/Usage,
# @Structure, @Status) are minCount 1: any Weakness loaded by the
# enrichment-aware loader carries them, and a graph loaded by the
# pre-enrichment loader is expected to fail until re-ingested.

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix kgcs:  <http://www.motherhacker.me/kgcs/ontology/core#> .
@prefix cwe:   <http://www.motherhacker.me/kgcs/ontology/cwe#> .


# ---------------------------------------------------------------------------
# Weakness node shape
#
# Identity (v1.0):
#   - cweId: canonical identifier e.g. CWE-79 — unique key
#   - abstraction: MITRE abstraction level from the fixed vocabulary
#
# The MITRE CWE abstraction hierarchy (most→least abstract):
#   Pillar > Class > Base > Variant > Compound
#
# Enrichment (v1.1, cwe-enrichment-v1.0.owl):
#   - description / extended_description: definitional text
#   - mapping_usage / mapping_reasons: CWE mapping guidance
#   - structure / status: entry metadata
#   - alternate_terms, likelihood_of_exploit, functional_areas,
#     affected_resources, modes_of_introduction, ordinalities: facets
# ---------------------------------------------------------------------------

cwe:WeaknessShape
    a sh:NodeShape ;
    sh:targetClass kgcs:Weakness ;

    # cweId: canonical identifier — primary unique key
    # Pattern: CWE- followed by integer (no leading zeros required by MITRE)
    sh:property [
        sh:path cwe:cweId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^CWE-\\d+$" ;
        sh:message "Weakness must have exactly one cweId matching CWE-N." ;
        sh:severity sh:Violation ;
    ] ;

    # abstraction: MITRE classification level — fixed vocabulary
    sh:property [
        sh:path cwe:abstraction ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "Pillar" "Class" "Base" "Variant" "Compound" ) ;
        sh:message "Weakness.abstraction must be one of: Pillar, Class, Base, Variant, Compound." ;
        sh:severity sh:Violation ;
    ] ;

    # ------------------------------------------------------------------
    # Enrichment v1.1 — definitional text
    # ------------------------------------------------------------------

    # description: required in XSD (Weakness/Description)
    sh:property [
        sh:path cwe:description ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "Weakness must have exactly one non-empty description." ;
        sh:severity sh:Violation ;
    ] ;

    # extended_description: optional, flattened from StructuredText
    sh:property [
        sh:path cwe:extended_description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "Weakness.extended_description must be a single string when present." ;
        sh:severity sh:Violation ;
    ] ;

    # ------------------------------------------------------------------
    # Enrichment v1.1 — mapping guidance (XSD Mapping_Notes, required)
    # ------------------------------------------------------------------

    sh:property [
        sh:path cwe:mapping_usage ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "Allowed" "Allowed-with-Review" "Discouraged" "Prohibited" ) ;
        sh:message "Weakness.mapping_usage must be one of: Allowed, Allowed-with-Review, Discouraged, Prohibited." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path cwe:mapping_reasons ;
        sh:datatype xsd:string ;
        sh:in ( "Abstraction" "Category" "View" "Deprecated"
                "Potential Deprecation" "Frequent Misuse"
                "Frequent Misinterpretation" "Multiple Use" "CWE Overlap"
                "Acceptable-Use" "Potential Major Changes" "Other" ) ;
        sh:message "Weakness.mapping_reasons values must come from the CWE ReasonEnumeration." ;
        sh:severity sh:Violation ;
    ] ;

    # ------------------------------------------------------------------
    # Enrichment v1.1 — entry metadata (XSD required attributes)
    # ------------------------------------------------------------------

    sh:property [
        sh:path cwe:structure ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "Simple" "Chain" "Composite" ) ;
        sh:message "Weakness.structure must be one of: Simple, Chain, Composite." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path cwe:status ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "Deprecated" "Draft" "Incomplete" "Obsolete" "Stable" "Usable" ) ;
        sh:message "Weakness.status must be one of: Deprecated, Draft, Incomplete, Obsolete, Stable, Usable." ;
        sh:severity sh:Violation ;
    ] ;

    # ------------------------------------------------------------------
    # Enrichment v1.1 — enum-controlled facets (all optional in XSD)
    # ------------------------------------------------------------------

    # alternate_terms: free strings (no source vocabulary), multi-valued
    sh:property [
        sh:path cwe:alternate_terms ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "Weakness.alternate_terms values must be non-empty strings." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path cwe:likelihood_of_exploit ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "High" "Medium" "Low" "Unknown" ) ;
        sh:message "Weakness.likelihood_of_exploit must be one of: High, Medium, Low, Unknown." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path cwe:functional_areas ;
        sh:datatype xsd:string ;
        sh:in ( "Authentication" "Authorization" "Code Libraries" "Counters"
                "Cryptography" "Error Handling" "Interprocess Communication"
                "File Processing" "Logging" "Memory Management" "Networking"
                "Number Processing" "Program Invocation" "Protection Mechanism"
                "Session Management" "Signals" "String Processing"
                "Not Functional-Area-Specific" "Power" "Clock" ) ;
        sh:message "Weakness.functional_areas values must come from the CWE FunctionalAreaEnumeration." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path cwe:affected_resources ;
        sh:datatype xsd:string ;
        sh:in ( "CPU" "File or Directory" "Memory" "System Process" "Other" ) ;
        sh:message "Weakness.affected_resources values must come from the CWE ResourceEnumeration." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path cwe:modes_of_introduction ;
        sh:datatype xsd:string ;
        sh:in ( "Policy" "Requirements" "Architecture and Design"
                "Implementation" "Build and Compilation" "Testing"
                "Documentation" "Bundling" "Distribution" "Installation"
                "System Configuration" "Operation" "Patching and Maintenance"
                "Porting" "Integration" "Manufacturing"
                "Decommissioning and End-of-Life" ) ;
        sh:message "Weakness.modes_of_introduction values must come from the CWE PhaseEnumeration." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path cwe:ordinalities ;
        sh:datatype xsd:string ;
        sh:in ( "Primary" "Resultant" "Indirect" ) ;
        sh:message "Weakness.ordinalities values must be one of: Primary, Resultant, Indirect." ;
        sh:severity sh:Violation ;
    ] .
