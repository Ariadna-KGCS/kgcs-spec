# KGCS CVE SHACL Shapes v1.2
#
# Validates Vulnerability, Reference and NVD applicability nodes against
# the CVE ontology (ontology/standards/cve-ontology-v1.0.owl), the CVE
# applicability module (ontology/standards/cve-applicability-v1.0.owl) and
# the CAUSED_BY provenance module
# (ontology/standards/cve-weakness-provenance-v1.0.owl).
#
# Source standard: NIST NVD CVE JSON 2.0
# Enforcement level: STRICT (reject at ingest)
#
# v1.1: adds the applicability-layer shapes. They encode, one to one, the
# three post-load Cypher checks of kgcs-pipeline
# validation/validate_all_standards.py that concern this layer -
# affects_backed_by_applicability, expanded_criteria_have_platform_targets,
# configuration_nodes_have_parent - plus the identity keys that
# init_constraints.py declares unique (vcId, vcnId). No other invariant is
# introduced. The SPARQL constraint requires a SHACL-SPARQL capable
# validator (pySHACL is one).
#
# v1.2: CAUSED_BY provenance (ADR-0002). cve:CausedByStatementShape validates
# the reified edge (aligned sources / sourceRoles / types lists of equal
# length, closed vocabularies, one statement per (CVE, CWE) pair, statement
# backed by a real kgcs:caused_by triple); cve:CausedByProvenanceCoverageShape
# warns on CAUSED_BY edges loaded without provenance (pre-v1.1 loaders).

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix kgcs:  <http://www.motherhacker.me/kgcs/ontology/core#> .
@prefix cve:   <http://www.motherhacker.me/kgcs/ontology/cve#> .
@prefix cpe:   <http://www.motherhacker.me/kgcs/ontology/cpe#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .


# ---------------------------------------------------------------------------
# Vulnerability node shape
#
# Every Vulnerability node requires:
#   - cveId matching the canonical CVE-YYYY-NNNNN format
#   - published date (NVD assignment date)
#   - source (NVD sourceIdentifier, e.g. cve@mitre.org)
#
# Note: CAUSED_BY (minCount 0) because NVD uses NVD-CWE-Other / NVD-CWE-noinfo
# for ~15% of CVEs, which have no mappable CWE ID. Tracked as a coverage metric
# in extract_neo4j_stats.py.
# ---------------------------------------------------------------------------

cve:VulnerabilityShape
    a sh:NodeShape ;
    sh:targetClass kgcs:Vulnerability ;

    # cveId: canonical identifier — primary unique key
    # Pattern: CVE-YYYY-NNNNN (4-digit year, variable-length sequence number)
    sh:property [
        sh:path cve:cveId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^CVE-\\d{4}-\\d+$" ;
        sh:message "Vulnerability must have exactly one cveId matching CVE-YYYY-NNNNN." ;
        sh:severity sh:Violation ;
    ] ;

    # published: xsd:dateTime per OWL range (graph layer stores ISO-8601 string)
    sh:property [
        sh:path cve:published ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:message "Vulnerability must have a published date." ;
        sh:severity sh:Violation ;
    ] ;

    # source: NVD sourceIdentifier (e.g. cve@mitre.org, security@huntrdev.com)
    sh:property [
        sh:path cve:source ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Vulnerability must have a source identifier." ;
        sh:severity sh:Warning ;
    ] .


# ---------------------------------------------------------------------------
# Reference node shape
#
# Every Reference node must carry the URL that it represents.
# References are deduplicated globally — the URL is the unique key.
# ---------------------------------------------------------------------------

cve:ReferenceShape
    a sh:NodeShape ;
    sh:targetClass kgcs:Reference ;

    # referenceUrl: canonical URL — unique key
    sh:property [
        sh:path cve:referenceUrl ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 7 ;
        sh:message "Reference must have exactly one referenceUrl." ;
        sh:severity sh:Violation ;
    ] .


# ---------------------------------------------------------------------------
# NVD applicability layer (v1.1, cve-applicability-v1.0.owl)
#
#   (Vulnerability)-[:HAS_CONFIGURATION]->(VulnerabilityConfiguration)
#     -[:HAS_NODE]->(VulnerabilityConfigurationNode)
#     -[:MATCHES_CRITERIA {vulnerable}]->(PlatformConfiguration)
#
# RDF carries the edge flag as cve:matches_vulnerable_criteria (true) /
# cve:matches_context_criteria (false), both sub-properties of
# cve:matches_criteria. Paths enumerate the three explicitly
# (sh:alternativePath) so no sub-property inference is required. Key patterns are derived from the loader
# (vcId = "<cveId>::CFG::<n>", vcnId = "<vcId>::NODE::<m>") and are Warnings,
# consistent with the other loader-derived patterns in this repo.
# ---------------------------------------------------------------------------

# SPARQL prefix declarations for the constraint below (SHACL-SPARQL 1.0).
cve:CVEShapesPrefixes
    a owl:Ontology ;
    sh:declare [
        sh:prefix "cve" ;
        sh:namespace "http://www.motherhacker.me/kgcs/ontology/cve#"^^xsd:anyURI ;
    ] , [
        sh:prefix "kgcs" ;
        sh:namespace "http://www.motherhacker.me/kgcs/ontology/core#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] .

cve:VulnerabilityConfigurationShape
    a sh:NodeShape ;
    sh:targetClass cve:VulnerabilityConfiguration ;

    # vcId: synthetic deterministic key (unique constraint in the graph)
    sh:property [
        sh:path cve:vcId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "VulnerabilityConfiguration must have exactly one vcId." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path cve:vcId ;
        sh:pattern "^CVE-\\d{4}-\\d+::CFG::\\d+$" ;
        sh:message "vcId should match <cveId>::CFG::<configIndex> (loader-derived key format)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path cve:negate ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "negate must be a single boolean when present." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path cve:operator ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "operator must be a single string when present." ;
        sh:severity sh:Violation ;
    ] .

cve:VulnerabilityConfigurationNodeShape
    a sh:NodeShape ;
    sh:targetClass cve:VulnerabilityConfigurationNode ;

    # vcnId: synthetic deterministic key (unique constraint in the graph)
    sh:property [
        sh:path cve:vcnId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "VulnerabilityConfigurationNode must have exactly one vcnId." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path cve:vcnId ;
        sh:pattern "^CVE-\\d{4}-\\d+::CFG::\\d+::NODE::\\d+$" ;
        sh:message "vcnId should match <vcId>::NODE::<nodeIndex> (loader-derived key format)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path cve:negate ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "negate must be a single boolean when present." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path cve:operator ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "operator must be a single string when present." ;
        sh:severity sh:Violation ;
    ] ;

    # configuration_nodes_have_parent: exactly one HAS_NODE parent
    sh:property [
        sh:path [ sh:inversePath cve:has_node ] ;
        sh:class cve:VulnerabilityConfiguration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every VulnerabilityConfigurationNode has exactly one HAS_NODE parent (post-load check configuration_nodes_have_parent)." ;
        sh:severity sh:Violation ;
    ] ;

    # expanded_criteria_have_platform_targets: every criterion reached from
    # this node that expands via MATCHES_PLATFORM resolves to a Platform with
    # canonical identifiers (cpeUri, cpeNameId)
    sh:property [
        sh:path ( [ sh:alternativePath ( cve:matches_criteria
                                         cve:matches_vulnerable_criteria
                                         cve:matches_context_criteria ) ]
                  cpe:matchesPlatform ) ;
        sh:class kgcs:Platform ;
        sh:node [
            a sh:NodeShape ;
            sh:property [ sh:path cpe:cpeUri ; sh:minCount 1 ; ] ;
            sh:property [ sh:path cpe:cpeNameId ; sh:minCount 1 ; ] ;
        ] ;
        sh:message "Every applicability criterion that expands via MATCHES_PLATFORM must resolve to a Platform with cpeUri and cpeNameId (post-load check expanded_criteria_have_platform_targets)." ;
        sh:severity sh:Violation ;
    ] .

# affects_backed_by_applicability: every AFFECTS edge is backed by a
# non-negated vulnerable applicability leaf. Mirrors the Cypher check:
#   MATCH (v)-[:AFFECTS]->(pc) WHERE NOT EXISTS {
#     (v)-[:HAS_CONFIGURATION]->(vc)-[:HAS_NODE]->(vcn)-[mc:MATCHES_CRITERIA]->(pc)
#     WHERE mc.vulnerable = true AND coalesce(vc.negate,false) = false
#       AND coalesce(vcn.negate,false) = false }
cve:AffectsBackedByApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass kgcs:Vulnerability ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes cve:CVEShapesPrefixes ;
        sh:message "Every AFFECTS edge must be backed by a non-negated vulnerable applicability leaf (post-load check affects_backed_by_applicability)." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this ?value ?path WHERE {
                $this cve:affects ?value .
                BIND (cve:affects AS ?path)
                FILTER NOT EXISTS {
                    $this cve:has_configuration ?vc .
                    ?vc cve:has_node ?vcn .
                    ?vcn cve:matches_vulnerable_criteria ?value .
                    FILTER NOT EXISTS { ?vc cve:negate true }
                    FILTER NOT EXISTS { ?vcn cve:negate true }
                }
            }
        """ ;
    ] .


# ---------------------------------------------------------------------------
# CAUSED_BY provenance (v1.2, cve-weakness-provenance-v1.0.owl, ADR-0002)
#
# Graph: exactly one (Vulnerability)-[:CAUSED_BY]->(Weakness) edge per
# (CVE, CWE) pair with aligned list properties
#   sources     raw NVD weaknesses[].source identifiers
#   sourceRoles 'nvd' | 'cna' | 'adp'  ('adp' = declared ADP identifier,
#               today only 134c704f-9b21-4f2e-91b3-4a467353bcc0, CISA ADP)
#   types       'Primary' | 'Secondary'
# one entry per assigning weaknesses[] entry, same order in all three.
# RDF: one cve:CausedByStatement (rdf:Statement) per kgcs:caused_by triple
# whose three properties hold rdf:List values. List members are reached with
# the path  prop / rdf:rest* / rdf:first.
# ---------------------------------------------------------------------------

cve:CausedByStatementShape
    a sh:NodeShape ;
    sh:targetClass cve:CausedByStatement ;
    # Severity of the SPARQL constraints below is the shape's (SHACL 1.0:
    # sh:severity is read from the shape, not from sh:SPARQLConstraint).
    sh:severity sh:Violation ;

    # the reified edge: Vulnerability --kgcs:caused_by--> Weakness
    sh:property [
        sh:path rdf:subject ;
        sh:class kgcs:Vulnerability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "CAUSED_BY statement must have exactly one rdf:subject, a Vulnerability." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path rdf:predicate ;
        sh:hasValue kgcs:caused_by ;
        sh:maxCount 1 ;
        sh:message "CAUSED_BY statement must have rdf:predicate kgcs:caused_by." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path rdf:object ;
        sh:class kgcs:Weakness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "CAUSED_BY statement must have exactly one rdf:object, a Weakness." ;
        sh:severity sh:Violation ;
    ] ;

    # sources: exactly one non-empty rdf:List of strings
    sh:property [
        sh:path cve:weaknessSources ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "CAUSED_BY statement must have exactly one sources list." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path ( cve:weaknessSources [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "CAUSED_BY.sources must be a non-empty list of source identifier strings." ;
        sh:severity sh:Violation ;
    ] ;

    # sourceRoles: exactly one non-empty rdf:List of strings in {nvd, cna, adp}
    sh:property [
        sh:path cve:weaknessSourceRoles ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "CAUSED_BY statement must have exactly one sourceRoles list." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path ( cve:weaknessSourceRoles [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "nvd" "cna" "adp" ) ;
        sh:message "CAUSED_BY.sourceRoles members must be 'nvd', 'cna' or 'adp'." ;
        sh:severity sh:Violation ;
    ] ;

    # types: exactly one non-empty rdf:List of strings in {Primary, Secondary}
    sh:property [
        sh:path cve:weaknessTypes ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "CAUSED_BY statement must have exactly one types list." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path ( cve:weaknessTypes [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "Primary" "Secondary" ) ;
        sh:message "CAUSED_BY.types members must be 'Primary' or 'Secondary'." ;
        sh:severity sh:Violation ;
    ] ;

    # aligned lists: sources, sourceRoles and types have the same length
    # (rdf:rest* reaches each list cell once; cells are counted, not members,
    # so repeated values such as ["Secondary", "Secondary"] count twice)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes cve:CVEShapesPrefixes ;
        sh:message "CAUSED_BY.sources, sourceRoles and types must be index-aligned lists of equal length (one entry per assigning weaknesses[] entry)." ;
        sh:select """
            SELECT $this WHERE {
                $this cve:weaknessSources/rdf:rest* ?a . FILTER (?a != rdf:nil)
                $this cve:weaknessSourceRoles/rdf:rest* ?b . FILTER (?b != rdf:nil)
                $this cve:weaknessTypes/rdf:rest* ?c . FILTER (?c != rdf:nil)
            }
            GROUP BY $this
            HAVING (COUNT(DISTINCT ?a) != COUNT(DISTINCT ?b) || COUNT(DISTINCT ?a) != COUNT(DISTINCT ?c))
        """ ;
    ] ;

    # one statement per (CVE, CWE) pair, mirroring one CAUSED_BY edge per pair
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes cve:CVEShapesPrefixes ;
        sh:message "Exactly one CAUSED_BY edge (statement) per (CVE, CWE) pair: another statement reifies the same pair." ;
        sh:select """
            SELECT $this ?value WHERE {
                $this rdf:subject ?v ; rdf:object ?w .
                ?value a cve:CausedByStatement ; rdf:subject ?v ; rdf:object ?w .
                FILTER (?value != $this)
            }
        """ ;
    ] ;

    # the statement annotates an edge that exists
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes cve:CVEShapesPrefixes ;
        sh:message "CAUSED_BY statement reifies a kgcs:caused_by triple that is not in the graph." ;
        sh:select """
            SELECT $this WHERE {
                $this rdf:subject ?v ; rdf:object ?w .
                FILTER NOT EXISTS { ?v kgcs:caused_by ?w }
            }
        """ ;
    ] .

# Coverage: every CAUSED_BY edge carries provenance. Warning, not Violation:
# graphs loaded before the provenance-aware load_cwe.py have none, and the
# edge itself stays valid (ADR-0002).
cve:CausedByProvenanceCoverageShape
    a sh:NodeShape ;
    sh:targetClass kgcs:Vulnerability ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes cve:CVEShapesPrefixes ;
        sh:message "CAUSED_BY edge without provenance (sources / sourceRoles / types); reload with the provenance-aware loader." ;
        sh:select """
            SELECT $this ?value ?path WHERE {
                $this kgcs:caused_by ?value .
                BIND (kgcs:caused_by AS ?path)
                FILTER NOT EXISTS {
                    ?st a cve:CausedByStatement ; rdf:subject $this ; rdf:object ?value .
                }
            }
        """ ;
    ] .
